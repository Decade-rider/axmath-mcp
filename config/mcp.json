{
  "mcpServers": {
    "axmath": {
      "command": "uv",
      "args": ["--directory", "C:\\path\\to\\axmath-mcp", "run", "--no-sync", "python", "-m", "axmath_mcp.server"],
      "env": {
        "UV_CACHE_DIR": "C:\\path\\to\\axmath-mcp\\.uv-cache",
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1",
        "AXMATH_MCP_VERSION": "0.3.0"
      }
    }
  }
}
